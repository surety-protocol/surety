# Copy to .env.local and adjust

# Set to false to switch from mock data to live NEAR RPC
VITE_USE_MOCK=true

# NEAR testnet RPC endpoint
VITE_RPC_URL=https://rpc.testnet.near.org

# Surety contract on testnet (fill in once deployed)
VITE_CONTRACT_ID=surety.testnet

# Dev 2's judge/demo API
VITE_DEMO_API_URL=http://localhost:8787

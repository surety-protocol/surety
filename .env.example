# Copy to .env and fill in. NEVER commit .env.
# Testnet only. See docs/SPEC.md section 8.

NEAR_NETWORK=testnet
NEAR_RPC_URL=            # testnet, e.g. https://test.rpc.fastnear.com (list: https://docs.near.org/api/rpc/providers)
NEAR_PARENT=             # e.g. surety-team.testnet
NEAR_PARENT_PRIVATE_KEY= # used only by setup:testnet and deploy
# Everything below down to BACKER_PRIVATE_KEY is filled in by npm run setup:testnet.
SURETY_CONTRACT_ID=
TOKEN_ID=
JUDGE_ACCOUNT_ID=
JUDGE_PRIVATE_KEY=       # function-call key: submit_verdict, settle
PANEL_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=
HONEST_AGENT_PRIVATE_KEY=  # full access: agents bond with ft_transfer_call (1 yoctoNEAR)
SLOPPY_AGENT_PRIVATE_KEY=
CHEATER_AGENT_PRIVATE_KEY=
BACKER_PRIVATE_KEY=
FAKE_CLIENT_1_PRIVATE_KEY= # the cheater's sock puppets
FAKE_CLIENT_2_PRIVATE_KEY=
FAKE_CLIENT_3_PRIVATE_KEY=
CORE_PRIVATE_KEY=        # deploy only
TOKEN_PRIVATE_KEY=       # deploy only (token owner, mints tUSDC)
JUDGE_FULL_PRIVATE_KEY=  # judge account's full key, kept for recovery; the service uses JUDGE_PRIVATE_KEY
HONEST_AGENT_FC_PRIVATE_KEY=  # function-call keys: register_agent, accept_job, deliver
SLOPPY_AGENT_FC_PRIVATE_KEY=
CHEATER_AGENT_FC_PRIVATE_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
JUDGE_MODELS=deepseek-ai/DeepSeek-V4.1-Flash-1017,z-ai/glm-5.3-flash,Qwen/Qwen3.8-27B  # NEAR-operated TEE models, 3 labs
JUDGE_AI_MODE=nearai     # nearai | offline (offline = local dev only, receipts marked UNVERIFIED)
JUDGE_ALLOW_UNVERIFIED=0 # 1 lets offline votes count. NEVER for the real demo
JUDGE_ACCEPTED_TCB=UpToDate
JUDGE_REQUIRE_GPU=1
JUDGE_DOCKER=0           # 1 = run patched code in a no-network container (needs Docker)
JUDGE_POLL_MS=4000
JUDGE_MAX_TOKENS=4096      # completion budget per AI vote; the judges reason first, so keep it well above 600
SURETY_CHAIN=near        # near | mock (mock = in-memory chain before the contract is deployed)
DEMO_CORS_ORIGINS=http://localhost:5173
DEMO_API_PORT=8787

# web/ (Vite)
VITE_NEAR_NETWORK=testnet
VITE_RPC_URL=
VITE_CONTRACT_ID=
VITE_TOKEN_ID=
VITE_DEMO_API_URL=http://localhost:8787
